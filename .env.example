# ClaimReady — environment
# The app works fully WITHOUT these (it falls back to a deterministic engine,
# so the demo never breaks). Set them to make it genuinely OpenAI-powered at runtime.

# Your OpenAI API key. Server-side only — never exposed to the browser.
OPENAI_API_KEY=

# Optional: which OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: your deployed URL (used for the sitemap, robots.txt, and Open
# Graph tags). Set this to your real Vercel URL after deploying; the app
# works fine without it, it just falls back to a placeholder domain.
NEXT_PUBLIC_SITE_URL=https://claimready.example.com
