# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the committed template (no secrets in it);
# everything else stays local/untracked.
.env*
!.env.example

# vercel
.vercel

# Claude Code / gstack local session state — .claude/settings.json (shared
# plugin config) stays tracked; these are ephemeral, machine/session-specific.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.gstack/

# typescript
*.tsbuildinfo
next-env.d.ts
